{
  "name": "garr",
  "version": "0.1.0",
  "description": "Global Agent Root Registry — v1 skeleton",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0 <21.0.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx --env-file=.env src/db/migrate.ts",
    "demo:seed": "GARR_DEMO_MODE=true tsx --env-file=.env scripts/seed-demo.ts",
    "demo:rap": "tsx scripts/mock-rap.ts",
    "demo:run": "GARR_DEMO_MODE=true tsx --env-file=.env scripts/demo-flow.ts",
    "a2a:rap:weather": "tsx scripts/a2a/rap-weathercorp.ts",
    "a2a:rap:translate": "tsx scripts/a2a/rap-translatehub.ts",
    "a2a:weather": "tsx scripts/a2a/weather-agent.ts",
    "a2a:translator": "tsx scripts/a2a/translator-agent.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.6",
    "fastify": "^5.1.0",
    "postgres": "^3.4.4"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
