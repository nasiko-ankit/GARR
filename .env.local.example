# NANDA Index + Registry Server environment variables
# Copy to .env.local and fill in values for local development
# Run: docker compose -f docker-compose.local.yml --env-file .env.local up --build

# ── NANDA Index Server ────────────────────────────────────────────────────────
GARR_POSTGRES_PASSWORD=garr-local

# Optional — only used for signed responses
GARR_SIGNING_KEY_ID=garr-dev-2026
GARR_SIGNING_PRIVATE_KEY=

# OAuth (create apps at console.cloud.google.com and github.com/settings/developers)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_CALLBACK_BASE_URL=http://localhost:8080

# JWT — any secret works locally
JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRES_IN=7d

# Email (log = print verification link to console; no real email sent)
SMTP_URL=log
EMAIL_FROM=noreply@nanda.local

# Frontend
FRONTEND_URL=http://localhost:80

# ── Registry Server ───────────────────────────────────────────────────────────
REGISTRY_POSTGRES_PASSWORD=registry-local
REGISTRY_ADMIN_TOKEN=dev-token-change-in-production

# ── garr-web ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GARR_API_BASE_URL=http://localhost:8080

# ── Shared ────────────────────────────────────────────────────────────────────
DB_MAX_CONNECTIONS=10
