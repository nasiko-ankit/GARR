# ── Required ────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://rap:rap@localhost:5432/rap

# Ed25519 private key PEM — use \n for line breaks, or inject from a secrets manager
# Generate: openssl genpkey -algorithm Ed25519 -out signing-private.pem
SIGNING_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----

# Key identifier — must match key_id you register in GARR
SIGNING_KEY_ID=mycompany-key-2026

# Your internet domain (e.g. acme.com — not a URL, just the domain)
RAP_DOMAIN=mycompany.com

# Admin API key — protects POST/PUT/DELETE. Generate: openssl rand -hex 32
ADMIN_API_KEY=change-me-to-a-long-random-secret-at-least-32-chars

# ── Optional ────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# Comma-separated allowed CORS origins. Use * to allow all (dev only).
CORS_ORIGINS=*

# Max requests per minute per IP before 429
RATE_LIMIT_MAX=120

# PostgreSQL connection pool size
DB_MAX_CONNECTIONS=10
