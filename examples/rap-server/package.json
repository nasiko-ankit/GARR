{
  "name": "garr-rap",
  "version": "1.0.0",
  "description": "Production RAP (Registry Access Point) server for GARR",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev":     "tsx watch --env-file=.env src/server.ts",
    "build":   "tsc -p tsconfig.json",
    "start":   "node dist/server.js",
    "migrate": "tsx --env-file=.env src/migrate.ts"
  },
  "dependencies": {
    "@fastify/cors":       "^11.2.0",
    "@fastify/rate-limit": "^10.2.0",
    "fastify":             "^5.1.0",
    "postgres":            "^3.4.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx":         "^4.19.0",
    "typescript":  "^5.6.0"
  }
}
