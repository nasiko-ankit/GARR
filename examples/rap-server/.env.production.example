# Postgres password for the RAP database
RAP_POSTGRES_PASSWORD=change-me-strong-password

# Ed25519 private key — PEM with literal \n instead of real newlines
# Generate a separate keypair — do NOT reuse the GARR signing key
#   openssl genpkey -algorithm Ed25519 -out rap-signing.pem
#   awk 'NF {printf "%s\\n", $0}' rap-signing.pem
RAP_SIGNING_PRIVATE_KEY=

# Must match the key ID registered with GARR for this EntityOwner
RAP_SIGNING_KEY_ID=rap-prod-2026

# Domain this RAP serves (just the domain, e.g. nasiko.com — no https://)
RAP_DOMAIN=yourdomain.com

# EntityOwner owner_id registered in GARR
RAP_OWNER_ID=your-org-id

# Secret for write operations — min 32 chars
# Generate: openssl rand -hex 32
RAP_ADMIN_API_KEY=

# DB connection pool size
DB_MAX_CONNECTIONS=20
