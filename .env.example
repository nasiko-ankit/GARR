# === Required ===

# Postgres connection string. The Docker Compose stack exposes Postgres
# on host port 5433 (container 5432) to avoid clashing with any native
# Postgres that may be on host 5432.
DATABASE_URL=postgresql://garr:garr@localhost:5433/garr

# Ed25519 private key, PEM format.
# Signing is not used until Session 2, so a blank value is acceptable
# for Session 1 boot — but the config loader will still require the
# variable to be present (non-empty) per CLAUDE.md §332–357. Set a
# placeholder like "session-2-will-generate" for now, or generate a
# real dev keypair:
#   openssl genpkey -algorithm Ed25519 -out dev-signing.pem
#   cat dev-signing.pem
# and paste the PEM as a single-line value with literal \n separators,
# or use a dotenv loader that handles multi-line quoted values.
SIGNING_PRIVATE_KEY=

# === Optional ===

PORT=3000
NODE_ENV=development
SIGNING_KEY_ID=garr-dev-2026
DB_MAX_CONNECTIONS=10

# Demo escape hatch: when "true", POST /api/v1/register skips DMARC TXT
# and RAP HEAD checks. Lets the seed script register fake registries
# (google-demo, walmart-demo) whose domains have no real DNS/HTTPS.
# Challenge/signature verification on /verify still runs normally.
# Off by default. Set to "true" only for local demos.
GARR_MOCK_VERIFICATION=false

# Override the NANDA Index base URL used by the resolver. When set the
# resolver builds `<base>/lookup?agent=...` instead of hitting the spec
# default `https://nandaindex.org/lookup?...`. Used by the demo to point
# resolve at the local mock NANDA route mounted on this server.
# Example for local demo:
#   NANDA_INDEX_BASE_URL=http://localhost:3000/mock/nanda
NANDA_INDEX_BASE_URL=
