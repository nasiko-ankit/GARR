# Postgres password for the GARR index database
GARR_POSTGRES_PASSWORD=change-me-strong-password

# Ed25519 private key — PEM with literal \n instead of real newlines
# Generate:
#   openssl genpkey -algorithm Ed25519 -out garr-signing.pem
#   awk 'NF {printf "%s\\n", $0}' garr-signing.pem
GARR_SIGNING_PRIVATE_KEY=

# Identifier written into signed records
GARR_SIGNING_KEY_ID=garr-prod-2026

# DB connection pool size
DB_MAX_CONNECTIONS=20

# Public API URL — what browsers use to reach the GARR API
# Set to your Droplet's public IP
NEXT_PUBLIC_GARR_API_BASE_URL=http://YOUR_DROPLET_IP:8080
